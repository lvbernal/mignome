[Palette]
Name=Anniq

# Modo claro: fondo background, texto on-background, cursor primary.
# Los colores normales son variantes oscuras legibles sobre el fondo claro;
# los brillantes son los colores de la app (error, success, warning, info).
[Light]
Background=#F1F8F6
Foreground=#1B2528
Cursor=#0D5F18
