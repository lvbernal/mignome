  },
  "tokenColors": [
    {
      "name": "Comentarios",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#928B82",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Palabras clave y control",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#DE958E"
      }
    },
    {
      "name": "Almacenamiento y declaraciones",
      "scope": [
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#D8A485"
      }
    },
    {
      "name": "Importaciones y preprocesador",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.other.import",
        "meta.preprocessor",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#C5A4C6"
      }
    },
    {
      "name": "Operadores",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#B1AA9E"
      }
    },
    {
      "name": "Puntuación",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#928B82"
      }
    },
    {
      "name": "Cadenas",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#9EBC8F"
      }
    },
    {
      "name": "Escapes y expresiones regulares",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class"
      ],
      "settings": {
        "foreground": "#D8A485"
      }
    },
    {
      "name": "Números y booleanos",
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#C5A4C6"
      }
    },
    {
      "name": "Constantes",
      "scope": [
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#C5A4C6"
      }
    },
    {
      "name": "this/self",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#C5A4C6"
      }
    },
    {
      "name": "Funciones",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#8EB8CE"
      }
    },
    {
      "name": "Tipos y clases",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#C1B176"
      }
    },
    {
      "name": "Variables y parámetros",
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#D9D0C1"
      }
    },
    {
      "name": "Propiedades",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#89BEAF"
      }
    },
    {
      "name": "Etiquetas HTML/XML",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#DE958E"
      }
    },
    {
      "name": "Atributos",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#C1B176"
      }
    },
    {
      "name": "Decoradores",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#C5A4C6"
      }
    },
    {
      "name": "Inválido",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#DE958E"
      }
    },
    {
      "name": "Markdown: títulos",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#D3A974",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: énfasis",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#D8A485",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: cursiva",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#C5A4C6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown: enlaces",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#8EB8CE"
      }
    },
    {
      "name": "Markdown: código",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#9EBC8F"
      }
    },
    {
      "name": "Markdown: citas y listas",
      "scope": [
        "markup.quote",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#928B82"
      }
    },
    {
      "name": "Diff añadido",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#9EBC8F"
      }
    },
    {
      "name": "Diff eliminado",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#DE958E"
      }
    },
    {
      "name": "Diff cambiado",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#8EB8CE"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#C1B176",
    "class": "#C1B176",
    "interface": "#C1B176",
    "enum": "#C1B176",
    "type": "#C1B176",
    "typeParameter": "#C1B176",
    "function": "#8EB8CE",
    "method": "#8EB8CE",
    "decorator": "#C5A4C6",
    "enumMember": "#C5A4C6",
    "variable.readonly": "#C5A4C6",
    "parameter": "#D9D0C1",
    "property": "#89BEAF",
    "keyword": "#DE958E"
  }
}
