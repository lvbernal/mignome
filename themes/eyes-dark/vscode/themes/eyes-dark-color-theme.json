    "terminal.ansiGreen": "#9EBC8F",
    "terminal.ansiYellow": "#C1B176",
    "terminal.ansiBlue": "#8EB8CE",
    "terminal.ansiMagenta": "#C5A4C6",
    "terminal.ansiCyan": "#89BEAF",
    "terminal.ansiWhite": "#B1AA9E",
    "terminal.ansiBrightBlack": "#928B82",
    "terminal.ansiBrightRed": "#F4B0AA",
    "terminal.ansiBrightGreen": "#B6D1A8",
