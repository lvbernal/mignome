  "tokenColors": [
    {
      "name": "Comentarios",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#859289",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Palabras clave y control",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E67E80"
      }
    },
    {
      "name": "Almacenamiento y declaraciones",
      "scope": [
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#E69875"
      }
    },
    {
      "name": "Importaciones y preprocesador",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.other.import",
        "meta.preprocessor",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#D699B6"
      }
    },
    {
      "name": "Operadores",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#E69875"
      }
    },
    {
      "name": "Puntuación",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#859289"
      }
    },
    {
      "name": "Cadenas",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#83C092"
      }
    },
    {
      "name": "Escapes y expresiones regulares",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class"
      ],
      "settings": {
        "foreground": "#A7C080"
      }
    },
    {
      "name": "Números y booleanos",
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#D699B6"
      }
    },
    {
      "name": "Constantes",
      "scope": [
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#83C092"
      }
    },
    {
      "name": "this/self",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#D699B6"
      }
    },
    {
      "name": "Funciones",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#A7C080"
      }
    },
    {
      "name": "Tipos y clases",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#DBBC7F"
      }
    },
    {
      "name": "Variables y parámetros",
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#D3C6AA"
      }
    },
    {
      "name": "Propiedades",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#7FBBB3"
      }
    },
    {
      "name": "Etiquetas HTML/XML",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#E69875"
      }
    },
    {
      "name": "Atributos",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#DBBC7F"
      }
    },
    {
      "name": "Decoradores",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#D699B6"
      }
    },
    {
      "name": "Inválido",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E67E80"
      }
    },
    {
      "name": "Markdown: títulos",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#E67E80",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: énfasis",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E69875",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: cursiva",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#DBBC7F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown: enlaces",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#D699B6"
      }
    },
    {
      "name": "Markdown: código",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#A7C080"
      }
    },
    {
      "name": "Markdown: citas y listas",
      "scope": [
        "markup.quote",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#859289"
      }
    },
    {
      "name": "Diff añadido",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#A7C080"
      }
    },
    {
      "name": "Diff eliminado",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#E67E80"
      }
    },
    {
      "name": "Diff cambiado",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#7FBBB3"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#DBBC7F",
    "class": "#DBBC7F",
    "interface": "#DBBC7F",
    "enum": "#DBBC7F",
    "type": "#DBBC7F",
    "typeParameter": "#DBBC7F",
    "function": "#A7C080",
    "method": "#A7C080",
    "decorator": "#D699B6",
    "enumMember": "#83C092",
    "variable.readonly": "#83C092",
    "parameter": "#D3C6AA",
    "property": "#7FBBB3",
    "keyword": "#E67E80"
  }
}
