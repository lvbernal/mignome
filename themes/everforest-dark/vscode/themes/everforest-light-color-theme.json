  "tokenColors": [
    {
      "name": "Comentarios",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#939F91",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Palabras clave y control",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F85552"
      }
    },
    {
      "name": "Almacenamiento y declaraciones",
      "scope": [
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#F57D26"
      }
    },
    {
      "name": "Importaciones y preprocesador",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.other.import",
        "meta.preprocessor",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#DF69BA"
      }
    },
    {
      "name": "Operadores",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#F57D26"
      }
    },
    {
      "name": "Puntuación",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#939F91"
      }
    },
    {
      "name": "Cadenas",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#35A77C"
      }
    },
    {
      "name": "Escapes y expresiones regulares",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class"
      ],
      "settings": {
        "foreground": "#8DA101"
      }
    },
    {
      "name": "Números y booleanos",
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#DF69BA"
      }
    },
    {
      "name": "Constantes",
      "scope": [
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#35A77C"
      }
    },
    {
      "name": "this/self",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#DF69BA"
      }
    },
    {
      "name": "Funciones",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#8DA101"
      }
    },
    {
      "name": "Tipos y clases",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#DFA000"
      }
    },
    {
      "name": "Variables y parámetros",
      "scope": [
        "variable",
        "variable.parameter",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#5C6A72"
      }
    },
    {
      "name": "Propiedades",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#3A94C5"
      }
    },
    {
      "name": "Etiquetas HTML/XML",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#F57D26"
      }
    },
    {
      "name": "Atributos",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#DFA000"
      }
    },
    {
      "name": "Decoradores",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#DF69BA"
      }
    },
    {
      "name": "Inválido",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F85552"
      }
    },
    {
      "name": "Markdown: títulos",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#F85552",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: énfasis",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F57D26",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown: cursiva",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#DFA000",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown: enlaces",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#DF69BA"
      }
    },
    {
      "name": "Markdown: código",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#8DA101"
      }
    },
    {
      "name": "Markdown: citas y listas",
      "scope": [
        "markup.quote",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#939F91"
      }
    },
    {
      "name": "Diff añadido",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#8DA101"
      }
    },
    {
      "name": "Diff eliminado",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#F85552"
      }
    },
    {
      "name": "Diff cambiado",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#3A94C5"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#DFA000",
    "class": "#DFA000",
    "interface": "#DFA000",
    "enum": "#DFA000",
    "type": "#DFA000",
    "typeParameter": "#DFA000",
    "function": "#8DA101",
    "method": "#8DA101",
    "decorator": "#DF69BA",
    "enumMember": "#35A77C",
    "variable.readonly": "#35A77C",
    "parameter": "#5C6A72",
    "property": "#3A94C5",
    "keyword": "#F85552"
  }
}
