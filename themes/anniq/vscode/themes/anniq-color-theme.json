  "tokenColors": [
    {
      "name": "Comentarios",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#5F6A6C", "fontStyle": "italic" }
    },
    {
      "name": "Palabras clave y almacenamiento",
      "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "variable.language.this", "variable.language.self"],
      "settings": { "foreground": "#0D5F18" }
    },
    {
      "name": "Operadores y puntuación",
      "scope": ["keyword.operator", "punctuation"],
      "settings": { "foreground": "#1B2528" }
    },
    {
      "name": "Cadenas",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#8A5A00" }
    },
    {
      "name": "Escapes y expresiones regulares",
      "scope": ["constant.character.escape", "string.regexp", "constant.other.character-class"],
      "settings": { "foreground": "#C62828" }
    },
    {
      "name": "Números y constantes",
      "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant", "variable.other.constant", "variable.other.enummember"],
      "settings": { "foreground": "#077A8C" }
    },
    {
      "name": "Funciones",
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function"],
      "settings": { "foreground": "#7B3F9E" }
    },
    {
      "name": "Tipos y clases",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type", "support.class", "entity.other.inherited-class", "storage.type.primitive"],
      "settings": { "foreground": "#0B7A6E" }
    },
    {
      "name": "Variables y parámetros",
      "scope": ["variable", "variable.parameter", "meta.definition.variable"],
      "settings": { "foreground": "#1B2528" }
    },
    {
      "name": "Propiedades",
      "scope": ["variable.other.property", "variable.other.object.property", "support.type.property-name", "meta.object-literal.key"],
      "settings": { "foreground": "#1B2528" }
    },
    {
      "name": "Etiquetas HTML/XML",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#0D5F18" }
    },
    {
      "name": "Atributos",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#7B3F9E" }
    },
    {
      "name": "Decoradores",
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#0B7A6E" }
    },
    {
      "name": "Inválido",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#C62828" }
    },
    {
      "name": "Markdown: títulos",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#0D5F18", "fontStyle": "bold" }
    },
    {
      "name": "Markdown: énfasis",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markdown: cursiva",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown: enlaces y código",
      "scope": ["markup.underline.link", "markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#077A8C" }
    },
    {
      "name": "Diff",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#2B7A00" }
    },
    {
      "name": "Diff eliminado",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#C62828" }
    },
    {
      "name": "Diff cambiado",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#077A8C" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#0B7A6E",
    "class": "#0B7A6E",
    "interface": "#0B7A6E",
    "enum": "#0B7A6E",
    "type": "#0B7A6E",
    "typeParameter": "#0B7A6E",
    "function": "#7B3F9E",
    "method": "#7B3F9E",
    "decorator": "#0B7A6E",
    "enumMember": "#077A8C",
    "variable.readonly": "#077A8C",
    "parameter": "#1B2528",
    "property": "#1B2528",
    "keyword": "#0D5F18"
  }
}
